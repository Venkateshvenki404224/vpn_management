#!/usr/bin/env python3
"""Root-run unix-socket server that fronts a closed set of WireGuard verbs.

This is the security boundary between the unprivileged Frappe workers and the
host kernel. It runs as root inside the host-networked ``wg-agent`` sidecar,
accepts a JSON ``{"verb": ..., "args": [...]}`` request over a unix socket, and
re-validates *every* argument before shelling out. Nothing the worker sends is
trusted: the verb must be in :data:`ALLOWED_VERBS`, interfaces must match
``^wg[0-9]+$``, and conf files must resolve under :data:`WG_DIR` at mode 600.

Verbs: ``up <iface>``, ``syncconf <iface> <conf>``, ``show [<iface> [dump]]``.
"""

import json
import logging
import os
import re
import socket
import stat
import subprocess
import threading
import time
from concurrent.futures import ThreadPoolExecutor

WG_DIR = "/etc/wireguard"
SOCKET_DIR = "/run/wg-agent"
SOCKET_PATH = os.path.join(SOCKET_DIR, "agent.sock")
# uid allowed to use the socket. The container's frappe user is 1000; a
# standalone install passes the real bench uid via WG_AGENT_SOCKET_UID.
SOCKET_UID = int(os.environ.get("WG_AGENT_SOCKET_UID", "1000"))
LOGGER = logging.getLogger("wg-agent")

ALLOWED_VERBS = ("up", "syncconf", "show")
INTERFACE_PATTERN = re.compile(r"^wg[0-9]+$")
# Default-deny conf allowlist: wg-quick runs Pre/PostUp/Down + SaveConfig as
# root, so the agent accepts only these inert keys and rejects everything else
# (a compromised worker owns the render dir and must not smuggle in directives).
# PostUp/PostDown ARE accepted, but their values are constrained to validated
# iptables/ip6tables calls (see _assert_firewall_directive) — they are the one
# directive this app needs and the only place a root command may reach the shell.
CONF_SECTION_KEYS = {
	"interface": {"privatekey", "address", "listenport", "mtu", "dns", "postup", "postdown"},
	"peer": {"publickey", "presharedkey", "allowedips", "endpoint", "persistentkeepalive"},
}
FIREWALL_KEYS = {"postup", "postdown"}
FIREWALL_COMMANDS = {"iptables", "ip6tables"}
# A single iptables token: no shell metacharacters at all, only what iptables
# match/target args use (flags, interfaces, addrs/CIDRs, port lists, targets).
IPTABLES_TOKEN = re.compile(r"^[A-Za-z0-9_./,:+=-]+$")
# Shell connectors wg-quick honours between commands; each side is still validated
# as a full iptables command, so they cannot smuggle a non-iptables call (the
# idempotent ``-C … || -A …`` the app renders relies on ``||``).
FIREWALL_SEPARATOR = re.compile(r";|\|\||&&")
# Semantic allowlist: even a shell-safe iptables call is root-powerful, so we
# constrain it to the rule shapes this app emits — add/delete/check on the
# forward/NAT chains with an inert target. This stops a worker that owns the conf
# from flushing rules (-F/-X/-Z), setting a chain policy (-P), opening INPUT, or
# installing a DNAT/SNAT redirect, all of which otherwise pass IPTABLES_TOKEN.
FIREWALL_ACTIONS = {"-A", "-D", "-C"}
FIREWALL_TABLES = {"filter", "nat"}
FIREWALL_CHAINS = {"FORWARD", "POSTROUTING", "PREROUTING"}
FIREWALL_TARGETS = {"ACCEPT", "DROP", "RETURN", "MASQUERADE", "REDIRECT"}
FIREWALL_FORBIDDEN = {
	"-F",
	"--flush",
	"-P",
	"--policy",
	"-X",
	"--delete-chain",
	"-Z",
	"--zero",
	"-N",
	"--new-chain",
	"-E",
	"--rename-chain",
	"-R",
	"--replace",
	"-I",
	"--insert",
}
MAX_REQUEST = 64 * 1024
MAX_CONF = 64 * 1024
COMMAND_TIMEOUT = 30
MAX_WORKERS = 8
MAX_INFLIGHT = 32
# Root-owned scratch dir (NOT on the worker-shared volume): the agent stages the
# validated conf bytes here and points wg-quick/wg at this copy, so the root tool
# never re-reads the worker-writable render dir — closing the validate/use TOCTOU.
STAGE_DIR = "/run/wg-stage"


def assert_iface(iface):
	"""Reject anything that is not a canonical ``wg<number>`` interface name."""
	if not isinstance(iface, str) or not INTERFACE_PATTERN.match(iface):
		raise ValueError(f"invalid interface: {iface!r}")


def assert_under_dir(path, base):
	"""Return the real path, asserting it stays inside ``base`` (no symlink escape)."""
	real = os.path.realpath(path)
	base_real = os.path.realpath(base)
	if os.path.commonpath([real, base_real]) != base_real:
		raise ValueError(f"path escapes {base_real}: {path!r}")
	return real


def conf_path_for(iface):
	"""Map an interface to its conf path under :data:`WG_DIR`, escape-checked."""
	assert_iface(iface)
	return assert_under_dir(os.path.join(WG_DIR, f"{iface}.conf"), WG_DIR)


def _assert_conf_safe_text(text):
	"""Reject conf text carrying any key outside the inert allowlist.

	The worker owns the render dir, so the body is untrusted: this is what stops
	a smuggled ``PostUp``/``SaveConfig`` from running as root under wg-quick.
	"""
	section = None
	for raw_line in text.splitlines():
		line = raw_line.split("#", 1)[0].strip()
		if not line:
			continue
		if line.startswith("[") and line.endswith("]"):
			section = line[1:-1].strip().lower()
			if section not in CONF_SECTION_KEYS:
				raise ValueError(f"conf has an unknown section: {line!r}")
			continue
		if section is None or "=" not in line:
			raise ValueError(f"conf has a malformed line: {raw_line.strip()!r}")
		key = line.split("=", 1)[0].strip().lower()
		if key not in CONF_SECTION_KEYS[section]:
			raise ValueError(f"conf key not allowed in [{section}]: {key!r}")
		if key in FIREWALL_KEYS:
			_assert_firewall_directive(line.split("=", 1)[1].strip())


def _assert_firewall_directive(value):
	"""Allow ONLY constrained iptables/ip6tables calls in a PostUp/PostDown value.

	wg-quick runs PostUp/PostDown through a shell, so an unconstrained value is
	root code execution. Two layers: (1) shell safety — split on the connectors
	wg-quick honours and require every token of every command to be a bare
	iptables token (no metacharacter survives :data:`IPTABLES_TOKEN`); (2) iptables
	semantics — each command must be an add/delete/check on a forward/NAT chain
	with an inert target (:func:`_assert_firewall_command`), so a worker that owns
	the render dir still cannot flush rules, open INPUT, or install a DNAT as root.
	"""
	saw_command = False
	for command in FIREWALL_SEPARATOR.split(value):
		tokens = command.split()
		if not tokens:
			continue
		saw_command = True
		_assert_firewall_command(tokens)
	if not saw_command:
		raise ValueError("empty firewall directive")


def _assert_firewall_command(tokens):
	if tokens[0] not in FIREWALL_COMMANDS:
		raise ValueError(f"firewall directive must be iptables/ip6tables: {tokens!r}")
	for token in tokens[1:]:
		if not IPTABLES_TOKEN.match(token):
			raise ValueError(f"unsafe firewall token: {token!r}")
		if token in FIREWALL_FORBIDDEN:
			raise ValueError(f"forbidden iptables operation: {token!r}")
	_assert_one_value_in(tokens, FIREWALL_ACTIONS, FIREWALL_CHAINS, "chain")
	_assert_one_value_in(tokens, {"-j"}, FIREWALL_TARGETS, "target")
	if "-t" in tokens:
		_assert_one_value_in(tokens, {"-t"}, FIREWALL_TABLES, "table")


def _assert_one_value_in(tokens, flags, allowed, label):
	"""Require exactly one of ``flags``, with its following token inside ``allowed``."""
	positions = [index for index, token in enumerate(tokens) if token in flags]
	if len(positions) != 1:
		raise ValueError(f"firewall command needs exactly one {'/'.join(sorted(flags))}")
	index = positions[0]
	if index + 1 >= len(tokens) or tokens[index + 1] not in allowed:
		raise ValueError(f"firewall {label} not allowed")


def assert_conf_safe(path):
	"""File wrapper around :func:`_assert_conf_safe_text` (validation only)."""
	with open(path, encoding="utf-8") as handle:
		_assert_conf_safe_text(handle.read())


def read_validated_conf(iface):
	"""Read the worker-owned conf for ``iface`` exactly once and validate THOSE bytes.

	The render dir is writable by the unprivileged worker, so a stat-then-reopen
	would let it swap the file between the agent's check and wg-quick's read
	(a TOCTOU that yields root code execution via a smuggled PostUp). We open once,
	check the open fd, read the bytes, validate them, and return *these* bytes —
	the caller hands them to the root tools instead of the path.
	"""
	path = conf_path_for(iface)
	fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
	try:
		info = os.fstat(fd)
		if not stat.S_ISREG(info.st_mode):
			raise ValueError(f"conf is not a regular file: {path!r}")
		if stat.S_IMODE(info.st_mode) != 0o600:
			raise ValueError(f"conf must be mode 600: {path!r}")
		if info.st_size > MAX_CONF:
			raise ValueError(f"conf too large: {path!r}")
		data = os.read(fd, MAX_CONF)
	finally:
		os.close(fd)
	_assert_conf_safe_text(data.decode("utf-8"))
	return data


def stage_conf(iface, data):
	"""Write validated bytes to a root-owned file the worker cannot swap."""
	os.makedirs(STAGE_DIR, exist_ok=True)
	os.chmod(STAGE_DIR, 0o700)
	dest = os.path.join(STAGE_DIR, f"{iface}.conf")
	fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
	with os.fdopen(fd, "wb") as handle:
		handle.write(data)
	return dest


def _stage_validated(iface):
	"""Validate the iface's worker-owned conf and stage it root-owned; return the path."""
	return stage_conf(iface, read_validated_conf(iface))


def _envelope(completed):
	"""Wrap a finished subprocess in a JSON-serialisable result envelope."""
	return {
		"ok": completed.returncode == 0,
		"code": completed.returncode,
		"stdout": completed.stdout,
		"stderr": completed.stderr,
	}


def run(command):
	"""Run a validated command, returning a JSON-serialisable result envelope."""
	return _envelope(subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_TIMEOUT))


def run_syncconf(iface, path):
	"""Apply a config to a live interface without re-running PostUp/PostDown.

	``wg syncconf`` speaks the ``wg setconf`` dialect, which rejects wg-quick-only
	keys (Address, DNS, …), so the conf is first reduced with ``wg-quick strip``
	and piped in. The interface must already be up.
	"""
	stripped = subprocess.run(
		["wg-quick", "strip", path], capture_output=True, text=True, timeout=COMMAND_TIMEOUT
	)
	if stripped.returncode != 0:
		return _envelope(stripped)
	applied = subprocess.run(
		["wg", "syncconf", iface, "/dev/stdin"],
		input=stripped.stdout,
		capture_output=True,
		text=True,
		timeout=COMMAND_TIMEOUT,
	)
	return _envelope(applied)


def handle_up(args):
	if len(args) != 1:
		raise ValueError("up takes exactly one interface")
	iface = args[0]
	assert_iface(iface)
	return run(["wg-quick", "up", _stage_validated(iface)])


def handle_syncconf(args):
	if len(args) != 2:
		raise ValueError("syncconf takes an interface and a conf file")
	iface, conf = args
	assert_iface(iface)
	# Bind the conf arg to the interface (no divergence from up's coupling).
	if assert_under_dir(conf, WG_DIR) != conf_path_for(iface):
		raise ValueError(f"conf {conf!r} does not match interface {iface!r}")
	return run_syncconf(iface, _stage_validated(iface))


def handle_show(args):
	if not args:
		return run(["wg", "show", "interfaces"])
	iface = args[0]
	assert_iface(iface)
	if len(args) == 1:
		return run(["wg", "show", iface])
	if len(args) == 2 and args[1] == "dump":
		return run(["wg", "show", iface, "dump"])
	raise ValueError("show takes an interface and an optional 'dump'")


HANDLERS = {"up": handle_up, "syncconf": handle_syncconf, "show": handle_show}


def dispatch(raw):
	"""Validate a raw request payload and route it to its handler."""
	if len(raw) > MAX_REQUEST:
		raise ValueError("payload too large")
	message = json.loads(raw.decode("utf-8"))
	if not isinstance(message, dict):
		raise ValueError("request must be a JSON object")
	verb = message.get("verb")
	if verb not in ALLOWED_VERBS:
		raise ValueError(f"unknown verb: {verb!r}")
	args = message.get("args", [])
	if not isinstance(args, list):
		raise ValueError("args must be a list")
	return HANDLERS[verb](args)


def _read_request(connection):
	# Enforce a total wall-clock deadline so a trickle client cannot hold the
	# connection (and its worker slot) open past COMMAND_TIMEOUT.
	deadline = time.monotonic() + COMMAND_TIMEOUT
	chunks = []
	size = 0
	while True:
		remaining = deadline - time.monotonic()
		if remaining <= 0:
			raise ValueError("request read timed out")
		connection.settimeout(remaining)
		chunk = connection.recv(65536)
		if not chunk:
			break
		size += len(chunk)
		if size > MAX_REQUEST:
			raise ValueError("payload too large")
		chunks.append(chunk)
	return b"".join(chunks)


def _serve_connection(connection, inflight=None):
	try:
		with connection:
			connection.settimeout(COMMAND_TIMEOUT)
			try:
				reply = dispatch(_read_request(connection))
			except ValueError as error:
				reply = {"ok": False, "error": str(error)}
			except Exception as error:  # never crash the listener
				reply = {"ok": False, "error": f"agent error: {error}"}
			try:
				connection.sendall(json.dumps(reply).encode("utf-8"))
				connection.shutdown(socket.SHUT_WR)
			except OSError:
				pass
	finally:
		if inflight is not None:
			inflight.release()


def _bind_socket():
	os.makedirs(SOCKET_DIR, exist_ok=True)
	if os.path.exists(SOCKET_PATH):
		os.unlink(SOCKET_PATH)
	server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
	server.bind(SOCKET_PATH)
	os.chown(SOCKET_PATH, SOCKET_UID, SOCKET_UID)
	os.chmod(SOCKET_PATH, 0o600)
	_log_socket_ownership()
	server.listen(16)
	return server


def _log_socket_ownership():
	info = os.stat(SOCKET_PATH)
	LOGGER.info(
		"socket bound path=%s uid=%s gid=%s mode=%s",
		SOCKET_PATH,
		info.st_uid,
		info.st_gid,
		oct(stat.S_IMODE(info.st_mode)),
	)


def serve():
	server = _bind_socket()
	# Bounded pool + in-flight semaphore: a stuck/slow client cannot grow threads
	# or FDs without limit; excess connections are shed immediately.
	inflight = threading.Semaphore(MAX_INFLIGHT)
	with ThreadPoolExecutor(max_workers=MAX_WORKERS) as pool:
		while True:
			connection, _ = server.accept()
			if not inflight.acquire(blocking=False):
				connection.close()
				continue
			pool.submit(_serve_connection, connection, inflight)


if __name__ == "__main__":
	logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
	serve()
